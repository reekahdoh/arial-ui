# Copy to `.env.staging` (gitignored). Used by `npm run build:staging` and local `npm run test:e2e`.
# Create the Firebase project in Console first, then Project settings → Your apps → Web app.

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=arial-ui-staging.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=arial-ui-staging
REACT_APP_FIREBASE_APP_ID=

# Same-origin proxy (Firebase Hosting rewrite → Cloud Function).
REACT_APP_BACKEND_PROXY_URL=/backend

# Optional (only if your Firebase web config includes them)
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=

# Playwright (ignored by the CRA bundle; loaded by playwright.config.ts when `.env.staging` exists)
PLAYWRIGHT_BASE_URL=https://arial-ui-staging.web.app
E2E_LOGIN_NAME=
E2E_PASSWORD=
