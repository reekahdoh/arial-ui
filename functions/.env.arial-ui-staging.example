# Copy to `functions/.env.arial-ui-staging` (gitignored).
# Firebase loads `.env.<projectId>` for 2nd-gen functions in that project.
#
# Staging currently proxies to the same Cloud Run API as production.
# Copy BACKEND_* values from production `.env` (or functions/.env.arial-ui).
# Then grant the staging Functions service account roles/run.invoker (and
# roles/iap.httpsResourceAccessor if the API is behind IAP).

BACKEND_PROXY_TARGET=https://aira-api-PROJECT.REGION.run.app
BACKEND_ID_TOKEN_AUDIENCE=YOUR_IAP_CLIENT_ID.apps.googleusercontent.com
