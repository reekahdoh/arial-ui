{
  "name": "arial-ui",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@tanstack/react-query": "^5.99.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "firebase": "^11.10.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.72.1",
    "react-router-dom": "^6.30.3",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4",
    "zod": "^4.3.6"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build:staging": "env-cmd -f .env.staging react-scripts build",
    "deploy:staging": "npm run build:staging && firebase deploy --project staging --only hosting,functions,firestore",
    "eject": "react-scripts eject",
    "emulators:stop": "lsof -ti :9399,:9099,:4000,:4001,:4400,:4500,:8080,:9150,:9151 2>/dev/null | xargs kill -9 2>/dev/null; pkill -f 'firebase emulators:start' 2>/dev/null; pkill -f 'cloud-firestore-emulator' 2>/dev/null || true",
    "emulators": "firebase emulators:start --only auth,firestore",
    "setup:staging": "node scripts/setup-firebase-staging.js",
    "seed:firestore": "node scripts/seed-firestore.js",
    "seed:firestore:exec": "firebase emulators:exec --config firebase.seed.json --only firestore --project arial-ui \"node scripts/seed-firestore.js\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "complexity": [
        "error",
        12
      ],
      "max-lines-per-function": [
        "error",
        100
      ],
      "max-lines": [
        "error",
        300
      ]
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/e2e/"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "env-cmd": "^10.1.0",
    "firebase-admin": "^13.8.0",
    "firebase-tools": "^13.35.0",
    "google-auth-library": "^9.15.1",
    "typescript": "^4.9.5"
  }
}
