rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Login-name → email lookup for sign-in (must be readable before authentication).
    // Contains only lowercase email + uid; tighten further if you add App Check or a backend proxy.
    match /loginNames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string;
      allow update, delete: if false;
    }

    match /userProfiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Risk assessments captured by authenticated users.
    match /RiskAssessment/{assessmentId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasAny(['owner', 'companyName'])
        && request.resource.data.owner is string
        && request.resource.data.companyName is string;
      allow delete: if request.auth != null;
    }

    // Domain reference data (seeded with AI + WHO).
    match /Domain/{domainId} {
      // Public read: small fixed reference list (AI / WHO). Writes stay restricted.
      allow get, list: if true;
      // Allow authenticated clients to seed the fixed domain docs once.
      allow create, update: if request.auth != null
        && domainId in ['ai', 'who']
        && request.resource.data.keys().hasAll(['name'])
        && request.resource.data.name in ['AI', 'WHO'];
      allow delete: if false;
    }

    // References linked to a Domain doc via domainId.
    match /AuthorativeReference/{referenceId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['domainId', 'kind', 'value'])
        && request.resource.data.domainId is string
        && request.resource.data.kind in ['website', 'document']
        && request.resource.data.value is string;
      allow update, delete: if false;
    }

    // Customer-specific references linked to a RiskAssessment doc via assessmentId.
    match /CustomerDomainReference/{referenceId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasAll(['assessmentId', 'kind', 'value'])
        && request.resource.data.assessmentId is string
        && request.resource.data.kind in ['website', 'document']
        && request.resource.data.value is string;
      allow delete: if request.auth != null;
    }
  }
}
