rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function riskAssessmentDoc(assessmentId) {
      return get(/databases/$(database)/documents/RiskAssessment/$(assessmentId));
    }

    function ownsRiskAssessment(assessmentId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/RiskAssessment/$(assessmentId))
        && riskAssessmentDoc(assessmentId).data.ownerUid == request.auth.uid;
    }

    function isRiskAssessmentOwner() {
      return isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Login-name → email lookup for sign-in (must be readable before authentication).
    // Contains only lowercase email + uid; tighten further if you add App Check or a backend proxy.
    match /loginNames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string;
      allow update, delete: if false;
    }

    match /userProfiles/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Risk assessments: authenticated owners only.
    match /RiskAssessment/{assessmentId} {
      allow read: if isRiskAssessmentOwner();
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAny(['owner', 'companyName'])
        && request.resource.data.owner is string
        && request.resource.data.companyName is string;
      allow update: if isRiskAssessmentOwner()
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isRiskAssessmentOwner();
    }

    // Domain reference data (seeded with AI + WHO).
    match /Domain/{domainId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn()
        && domainId in ['ai', 'who']
        && request.resource.data.keys().hasAll(['name'])
        && request.resource.data.name in ['AI', 'WHO'];
      allow delete: if false;
    }

    // References linked to a Domain doc via domainId.
    match /AuthorativeReference/{referenceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['domainId', 'kind', 'value'])
        && request.resource.data.domainId is string
        && request.resource.data.kind in ['website', 'document']
        && request.resource.data.value is string;
      allow update, delete: if false;
    }

    // Customer-specific references linked to a RiskAssessment doc via assessmentId.
    match /CustomerDomainReference/{referenceId} {
      allow read: if isSignedIn() && ownsRiskAssessment(resource.data.assessmentId);
      allow create, update: if isSignedIn()
        && ownsRiskAssessment(request.resource.data.assessmentId)
        && request.resource.data.keys().hasAll(['assessmentId', 'kind', 'value'])
        && request.resource.data.assessmentId is string
        && request.resource.data.kind in ['website', 'document']
        && request.resource.data.value is string;
      allow delete: if isSignedIn() && ownsRiskAssessment(resource.data.assessmentId);
    }
  }
}
