# Copy to `.env` and fill with your Firebase project (Project settings → Your apps → Web app).
# `.env.local` overrides `.env` for local dev; do not put blank REACT_APP_FIREBASE_* there or production builds lose keys.
# https://console.firebase.google.com/
#
# For Google sign-in: Firebase console → Authentication → Sign-in method → enable Google.
# Add localhost to Authentication → Settings → Authorized domains when developing locally.

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_APP_ID=

# Browser-facing API base. Prefer same-origin "/backend" (private Cloud Run via proxy).
# Local: src/setupProxy.js → BACKEND_PROXY_TARGET (needs gcloud ADC + run.invoker)
# Prod: Firebase Hosting /backend/** → Cloud Function (Firebase Auth + Cloud Run ID token)
REACT_APP_BACKEND_PROXY_URL=/backend
BACKEND_PROXY_TARGET=https://aira-api-PROJECT.REGION.run.app
# IAP OAuth client ID for programmatic access (required when aira-api is behind IAP)
BACKEND_ID_TOKEN_AUDIENCE=YOUR_IAP_CLIENT_ID.apps.googleusercontent.com

# Optional (only if your Firebase web config includes them)
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=

# Local dev only (ignored when you run `npm run build`). Run `npm run emulators` first.
# With this flag, you can leave REACT_APP_FIREBASE_* empty — the app uses a demo web config and talks to the emulators only.
# REACT_APP_USE_FIREBASE_EMULATORS=true
